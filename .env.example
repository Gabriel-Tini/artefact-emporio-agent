# ==============================================================================
# EMPÓRIO DA MÚSICA - ASSISTENTE VIRTUAL AGÊNTICO
# Template de Variáveis de Ambiente (.env.example)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para `.env` na raiz do projeto:
#    cp .env.example .env
# 2. Preencha sua chave da API do Google Gemini abaixo.
#    O arquivo `.env` está protegido pelo `.gitignore` e nunca deve ser commitado.
# ==============================================================================

# Chave de API do Google Gemini / Vertex AI Express
# Formato esperado: AQ.**************************************************** ou AIza***********************************
GOOGLE_API_KEY="SUA_CHAVE_API_AQUI"
GEMINI_API_KEY="SUA_CHAVE_API_AQUI"

# Configurações dos Modelos Gemini
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="models/gemini-embedding-001"
GEMINI_TEMPERATURE="0.0"

# Configurações de Ambiente e Observabilidade
APP_ENV="development"
LOG_LEVEL="INFO"
